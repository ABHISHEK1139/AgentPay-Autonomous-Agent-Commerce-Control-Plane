# AgentPay environment configuration.
#
# Every value here is a placeholder for local development. Real credentials must come from a
# secret manager (blueprint §58) and must never be committed. Copy to .env and fill in locally;
# .env is gitignored.

# --- Core ---
AGENTPAY_ENVIRONMENT=local
AGENTPAY_LOG_LEVEL=INFO
AGENTPAY_TENANT_ID=tenant_01

# --- Persistence (declared in docker-compose.yml; not started by the app) ---
# Leave DATABASE_URL empty to use the in-memory repositories. Set it to use PostgreSQL, e.g.
# postgresql+psycopg://agentpay:agentpay_local_only@localhost:5432/agentpay
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentpay
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

# --- Demo data ---
# Local defaults to true. Development/sandbox require both flags below to opt in, and
# production always rejects demo seeding (blueprint §151).
AGENTPAY_SEED_DEMO_DATA=true
AGENTPAY_UNSAFE_ALLOW_DEMO_SEED=false

# --- Authentication (not implemented yet; no issuer configured) ---
# Leave unset. Autonomous payments default to disabled (blueprint §151).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Payments ---
# Sandbox only. Leave empty to use the mock provider. Live payments are refused.
AGENTPAY_PAYMENT_PROVIDER=mock
AGENTPAY_LIVE_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Alias accepted for either provider webhook secret.
AGENTPAY_WEBHOOK_SECRET=

# --- Security & observability ---
# Production/sandbox default this to true; local defaults to false.
AGENTPAY_REQUIRE_OBSERVABILITY_AUTH=false
# Wildcard CORS is refused in production.
AGENTPAY_CORS_ALLOWED_ORIGINS=*

# --- AI / decision intelligence ---
# Deterministic defaults. A decision engine is never a financial authority.
AGENTPAY_DECISION_ENGINE=mock
LLM_API_KEY=

# OrcaRouter
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# Any OpenAI-compatible endpoint, including local Ollama (default shown).
AGENTPAY_MODEL_API_KEY=
AGENTPAY_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENTPAY_MODEL_NAME=llama3.2
AGENTPAY_MODEL_PROVIDER_NAME=openai-compatible
# Only enable for a trusted private-network model endpoint.
AGENTPAY_MODEL_ALLOW_PRIVATE_NETWORK=false
